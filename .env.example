# ============================================================
# ShopMate configuration
# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file (it is already in .gitignore).
# ============================================================

# --- Required ---

# Telegram bot token. Get one from @BotFather on Telegram:
# 1. Open a chat with @BotFather
# 2. Send /newbot and follow the prompts
# 3. Paste the token you receive here
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Database connection string.
# Default: local SQLite file, zero setup needed.
# To use PostgreSQL instead: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./shopmate.db

# Secret key used to sign admin panel session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_KEY=change-me-to-a-random-64-char-secret

# Admin panel login credentials (used by the /admin panel, not Telegram).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# The store owner's numeric Telegram user ID.
# The bot sends new-order alerts and daily reports here.
# Get yours by messaging @userinfobot on Telegram.
OWNER_TELEGRAM_ID=

# --- Optional / branding ---

# Store or brand name shown to customers inside the bot.
STORE_NAME=My Shop

# IANA timezone name used for scheduled jobs (daily report time, etc).
TIMEZONE=Asia/Tashkent

# --- Optional: AI-powered FAQ ---
# Leave empty to use the built-in keyword-matching FAQ engine (default, free,
# no external calls). If set, ShopMate switches to an LLM-backed FAQ engine
# that calls an OpenAI-compatible chat-completions endpoint.
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Optional payment providers ---
# Each provider is only enabled when its required value(s) below are set.
# See PAYMENTS_GUIDE.md for how to obtain each one and for non-crypto
# alternatives (USDT/Wise) that need no code at all.

# Click.uz merchant account (https://my.click.uz)
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=

# Payme (https://business.payme.uz)
PAYME_MERCHANT_ID=

# Stripe secret key (https://dashboard.stripe.com/apikeys), for
# international card payments via Stripe Checkout.
STRIPE_KEY=
